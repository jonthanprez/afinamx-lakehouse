# ==========================================
# GENERAL
# ==========================================
PROJECT_NAME=afinamx-lakehouse
ENVIRONMENT=local

# ==========================================
# OBJECT STORAGE (Local MinIO -> S3 Compatible)
# ==========================================
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123
AWS_DEFAULT_REGION=us-east-1
# Host endpoint (overridden to http://minio:9000 inside docker-compose.yml)
AWS_ENDPOINT_URL=http://localhost:9000

S3_BUCKET_BRONZE=afinamx-bronze
S3_BUCKET_SILVER=afinamx-silver
S3_BUCKET_GOLD=afinamx-gold

# ==========================================
# ORCHESTRATION (PostgreSQL & Apache Airflow)
# ==========================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin