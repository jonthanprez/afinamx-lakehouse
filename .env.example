# ==============================================================================
# CONFIGURACIÓN NATIVA DE APACHE AIRFLOW (ACTUALIZADO A 3.x)
# ==============================================================================
AIRFLOW_IMAGE_NAME=apache/airflow:3.2.2-python3.11
AIRFLOW_UID=1000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Llave de cifrado obligatoria (Generar una cadena de 32 bytes en base64)
# Puedes generar una localmente en tu terminal con: openssl rand -base64 32
AIRFLOW_FERNET_KEY=7T0vX8b3Y2ZpQW7mK9rN1vFpX5sT8uC3vB4nM6xZ1qE=

# ==============================================================================
# REGLA DE ORO: INYECCIÓN DE CONEXIONES DE AIRFLOW (SIN TEXTO PLANO EN DAGS)
# ==============================================================================
# Nota: Apunta al puerto interno 5432 del contenedor, no al 5434 externo
AIRFLOW_CONN_POSTGRES_WOOCOMMERCE=postgresql+psycopg2://retail_user:secret_db_pass@postgres-ecommerce:5432/woocommerce
AIRFLOW_CONN_AWS_DEFAULT=aws://AKIAIOSFODNN7EXAMPLE:wJalrXUptIxE%2Fk7FinEXMPL%2FKEY@/?region_name=us-east-1

# ==============================================================================
# BASE DE DATOS TRANSACCIONAL (WOOCOMMERCE SIMULADO)
# ==============================================================================
POSTGRES_USER=retail_user
POSTGRES_PASSWORD=secret_db_pass
POSTGRES_DB=woocommerce

# ==============================================================================
# SWITCH DE ENTORNO (DEV por defecto)
# ==============================================================================
ENVIRONMENT=dev
