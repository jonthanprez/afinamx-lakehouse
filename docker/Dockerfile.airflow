FROM apache/airflow:3.0.2-python3.12

USER root

# Install OpenJDK 17 (required by PySpark 3.5 + Apache Iceberg)
RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-17-jre-headless && \
    ln -s /usr/lib/jvm/java-17-openjdk-* /usr/lib/jvm/java-17 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy pinned uv binary for strictly deterministic builds
COPY --from=ghcr.io/astral-sh/uv:0.6.6 /uv /uvx /usr/local/bin/

USER airflow

ENV JAVA_HOME=/usr/lib/jvm/java-17
ENV DBT_VENV_PATH=/opt/airflow/dbt_venv
ENV DBT_BIN=${DBT_VENV_PATH}/bin/dbt
ENV SPARK_HOME=${DBT_VENV_PATH}/lib/python3.12/site-packages/pyspark

# Create an isolated virtual environment aligned with uv.lock (PySpark 3.5 + dbt-spark + dbt-snowflake)
RUN uv venv ${DBT_VENV_PATH} && \
    uv pip install --python ${DBT_VENV_PATH}/bin/python --no-cache \
      "dbt-core==1.12.7" \
      "dbt-spark[session]==1.11.1" \
      "dbt-snowflake==1.12.5" \
      "pyspark==3.5.10"

# Pre-download Iceberg & Hadoop-AWS JARs into PySpark's classpath for offline/deterministic S3A + Iceberg runs
RUN curl -fsSL -o "${SPARK_HOME}/jars/iceberg-spark-runtime-3.5_2.12-1.8.1.jar" \
      "https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-spark-runtime-3.5_2.12/1.8.1/iceberg-spark-runtime-3.5_2.12-1.8.1.jar" && \
    curl -fsSL -o "${SPARK_HOME}/jars/hadoop-aws-3.3.4.jar" \
      "https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar" && \
    curl -fsSL -o "${SPARK_HOME}/jars/aws-java-sdk-bundle-1.12.262.jar" \
      "https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar"
