FROM apache/airflow:3.0.2-python3.12

USER root

# Copy pinned uv binary for strictly deterministic builds
COPY --from=ghcr.io/astral-sh/uv:0.6.6 /uv /uvx /usr/local/bin/

USER airflow

ENV DBT_VENV_PATH=/opt/airflow/dbt_venv
ENV DBT_BIN=${DBT_VENV_PATH}/bin/dbt

# Create an isolated virtual environment with pinned dbt + DuckDB versions
RUN uv venv ${DBT_VENV_PATH} && \
    uv pip install --python ${DBT_VENV_PATH}/bin/python --no-cache \
      "dbt-core==1.9.3" \
      "dbt-duckdb==1.9.2" \
      "duckdb==1.2.1"
